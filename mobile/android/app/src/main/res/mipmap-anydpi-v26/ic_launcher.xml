<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. The foreground already carries the icon's black
     plate, so the background matches it: rounder masks crop into the plate,
     squarer ones fall through to the same black. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+) tint a single alpha layer, so this one is
         the bare arrow — the plate would swallow the tint. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
